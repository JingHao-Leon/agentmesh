# ---- 复制成 .env 再改 ----
# docker compose 会自动读同目录的 .env

# 注册口令:留空 = 不限制谁可以注册(仅限本地演示,上线务必设置)
MESH_ENROLLMENT_TOKEN=

# ---- 租约与心跳 ----
# 租约:Agent 领到任务后必须在此时间内续租,否则任务自动回队列
MESH_LEASE_SECONDS=30
# 心跳间隔,建议取租约的 1/6 左右
MESH_HEARTBEAT_SECONDS=5
# 超过这个时间没有心跳,看板上标为离线
MESH_OFFLINE_AFTER=20
# 交接后被指名 Agent 的优先领取窗口;窗口一过任何人都能领
MESH_HANDOFF_PRIORITY_SECONDS=25

# ---- 网络 ----
MESH_HOST=0.0.0.0
MESH_PORT=8765
# 生产环境收紧成实际的前端域名,别用 *
MESH_CORS_ORIGINS=*

# ---- 路径(容器内已设好默认值,一般不用动)----
# MESH_DATA_DIR=/data
# MESH_KEYS_DIR=/keys